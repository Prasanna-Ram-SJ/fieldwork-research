# Public browser configuration
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Same project URL and publishable/anon key, used on the server
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server secrets. Never commit actual values.
NEBIUS_API_KEY=
NEBIUS_BASE_URL=https://api.tokenfactory.nebius.com/v1
# Publicly documented Nebius model; account access is not live-validated.
NEBIUS_MODEL=moonshotai/Kimi-K3.1-Pro
# Enable only after the owner explicitly authorizes live requests.
PROVIDER_REQUESTS_ENABLED=false
TAVILY_API_KEY=
MAX_TAVILY_CREDITS_MONTHLY=800
MAX_RESEARCH_TURNS_PER_USER_DAY=10
MAX_SEARCHES_PER_TURN=3
# Optional judge access is disabled unless configured with a persistent shared
# ledger. Local single-server setup: node scripts/configure-judge.cjs
# The setup writes a private access card under ignored .redesign-backup/.
# It does not make provider calls or reset an existing allowance.
# Do not carry a local filesystem ledger into a serverless/multi-instance deploy.
# Cloudflare uses JUDGE_LEDGER_BACKEND=d1 and the JUDGE_QUOTA binding instead.
# FIELDWORK_CLOUDFLARE=true selects the bounded Workers public-source transport.
# Never copy actual keys into Wrangler vars or generated build files.
